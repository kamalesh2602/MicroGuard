.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Local generated test results
results/*.csv
results/*.html

# Local runtime data
*.db
*.sqlite3

# Docker overrides and local configuration
docker-compose.override.yml

# Temporary files
*.tmp
*.bak
```
