```gitignore
# Environment variables and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.python-version
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

